{
	/* The server half: Pages Functions and the tests that exercise them. These
	   run in workerd, not the browser, so they get the Workers runtime types
	   rather than the DOM ones. */
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "es2022",
		"moduleResolution": "Bundler",
		"types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types", "node"],

		"resolveJsonModule": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.functions.tsbuildinfo"
	},
	"include": ["functions/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "worker-configuration.d.ts"]
}
