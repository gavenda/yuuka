# Public Auth0 configuration for the browser. These values are baked into the
# built bundle and are not secrets — a SPA cannot keep one.
#
# Copy to `.env`, then in the Auth0 dashboard add this app's origin to the
# Single Page Application's Allowed Callback URLs, Allowed Logout URLs and
# Allowed Web Origins. Auth0 returns to the site root, so these are plain
# origins with no path:
#   http://localhost:5173            (development)
#   https://<your-project>.pages.dev (production)

VITE_AUTH0_DOMAIN=

# The SPA application's Client ID, from Auth0 → Applications.
VITE_AUTH0_CLIENT_ID=

# The API identifier, from Auth0 → APIs. Must equal AUTH0_AUDIENCE in
# wrangler.jsonc, or the API will reject every token as wrongly addressed.
VITE_AUTH0_AUDIENCE=
