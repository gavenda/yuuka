# Public Auth0 configuration for the browser. These values are baked into the
# built bundle and are not secrets — a SPA cannot keep one.
#
# Copy to `.env`, then in the Auth0 dashboard add this app's origin to the
# Single Page Application's Allowed Callback URLs, Allowed Logout URLs and
# Allowed Web Origins. Auth0 returns to the site root, so these are plain
# origins with no path:
#   http://localhost:5173            (development)
#   https://<your-project>.pages.dev (production)

VITE_AUTH0_DOMAIN=

# The SPA application's Client ID, from Auth0 → Applications.
VITE_AUTH0_CLIENT_ID=

# The API identifier, from Auth0 → APIs. Must equal AUTH0_AUDIENCE in
# wrangler.jsonc, or the API will reject every token as wrongly addressed.
VITE_AUTH0_AUDIENCE=

# ---------------------------------------------------------------- Firebase
# Cloud Messaging, used to tell this browser that the Android app (or another
# tab) changed something, so it refetches only what moved instead of polling.
# Every value here is a public identifier from the Firebase console's web app
# config — the page ships them anyway. Leave them blank to build without push:
# the app still syncs on open, on reconnect and on pull-to-refresh.
#
# Project settings → General → Your apps → Web app → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Project settings → Cloud Messaging → Web configuration → Web Push certificates
VITE_FIREBASE_VAPID_KEY=
